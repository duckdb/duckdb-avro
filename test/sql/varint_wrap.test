# name: test/sql/varint_wrap.test
# description: a 10-byte varint with bits beyond the 64th is truncated to 64 bits, as Java and fastavro read it
# group: [sql]

require avro

# test/corpus/varint_wrap.avro (scripts/create_corpus_fixtures.py): pyiceberg zigzag-encoded a snapshot id of
# 9876543210123456789 into a 10-byte varint whose last byte sets the 65th bit; every reference reader wraps it
query I
SELECT v FROM read_avro('test/corpus/varint_wrap.avro');
----
-653171173268680982
