# name: test/sql/array_map_nullable_items.test
# description: a map-annotated array whose items are a nullable key/value record reads as a MAP
# group: [sql]

require avro

# test/corpus/array_map_nullable_items.avro (scripts/create_corpus_fixtures.py): BigQuery's export of an Iceberg
# manifest writes {"type": "array", "logicalType": "map", "items": ["null", {record key, value}]}. A null item has no
# place in a MAP and is skipped: the second row's first item is null.
query II
SELECT column_name, column_type FROM (DESCRIBE FROM read_avro('test/corpus/array_map_nullable_items.avro'));
----
m	MAP(INTEGER, BIGINT)

query I
SELECT m FROM read_avro('test/corpus/array_map_nullable_items.avro');
----
{1=2, 3=4}
{5=6}
NULL
