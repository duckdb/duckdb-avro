# name: test/sql/copy/test_timestamp_ms.test
# description: a TIMESTAMP_MS column is written as long + timestamp-millis and reads back unchanged
# group: [copy]

require avro

statement ok
COPY (
    FROM VALUES
        ('2024-01-15 12:34:56.123'::TIMESTAMP_MS),
        ('1969-12-31 23:59:59.999'::TIMESTAMP_MS),
        ('1900-02-03 04:05:06'::TIMESTAMP_MS),
        ('1970-01-01 00:00:00'::TIMESTAMP_MS),
        (NULL)
    t(ts)
) TO '__TEST_DIR__/timestamp_ms.avro';

# the schema carries the millisecond logical type, so other readers scale the values correctly
query I
SELECT value::JSON->'$.fields[0].type[1]' FROM avro_metadata('__TEST_DIR__/timestamp_ms.avro') WHERE key = 'avro.schema';
----
{"type":"long","logicalType":"timestamp-millis"}

query I
SELECT typeof(ts) FROM read_avro('__TEST_DIR__/timestamp_ms.avro') LIMIT 1;
----
TIMESTAMP

query I
SELECT ts FROM read_avro('__TEST_DIR__/timestamp_ms.avro') ORDER BY ts NULLS LAST;
----
1900-02-03 04:05:06
1969-12-31 23:59:59.999
1970-01-01 00:00:00
2024-01-15 12:34:56.123
NULL

# the round trip is exact
query I
SELECT count(*) FROM (
    SELECT ts FROM read_avro('__TEST_DIR__/timestamp_ms.avro')
    EXCEPT ALL
    FROM VALUES
        ('2024-01-15 12:34:56.123'::TIMESTAMP_MS),
        ('1969-12-31 23:59:59.999'::TIMESTAMP_MS),
        ('1900-02-03 04:05:06'::TIMESTAMP_MS),
        ('1970-01-01 00:00:00'::TIMESTAMP_MS),
        (NULL)
    t(ts)
);
----
0
