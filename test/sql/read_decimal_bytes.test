# name: test/sql/read_decimal_bytes.test
# description: Preserve decimal logical types on Avro bytes schemas
# group: [sql]

require avro

# Generated independently of DuckDB's fixed-decimal writer by
# scripts/create_decimal_bytes.py. Regression for duckdb/duckdb-avro#100.
# Both orders of the nullable union are present in the fixture.
query TT
SELECT column_name, column_type FROM (DESCRIBE FROM read_avro('test/decimal_bytes.avro'));
----
row_id	INTEGER
decimal_4_2	DECIMAL(4,2)
decimal_9_4	DECIMAL(9,4)
decimal_18_6	DECIMAL(18,6)
decimal_19_2	DECIMAL(19,2)
decimal_38_10	DECIMAL(38,10)
plain_bytes	BLOB

# Check exact decimal values, including precision limits, NULLs, zero,
# negative sign extension, and positive values requiring a leading sign byte.
query TTTTT
SELECT decimal_4_2, decimal_9_4, decimal_18_6, decimal_19_2, decimal_38_10
FROM read_avro('test/decimal_bytes.avro') ORDER BY row_id;
----
NULL	NULL	NULL	NULL	NULL
-99.99	-99999.9999	-999999999999.999999	-99999999999999999.99	-9999999999999999999999999999.9999999999
-30.49	-0.3049	-0.003049	-30.49	-0.0000003049
-1.29	-0.0129	-0.000129	-1.29	-0.0000000129
-1.28	-0.0128	-0.000128	-1.28	-0.0000000128
-0.01	-0.0001	-0.000001	-0.01	-0.0000000001
0.00	0.0000	0.000000	0.00	0.0000000000
0.01	0.0001	0.000001	0.01	0.0000000001
1.27	0.0127	0.000127	1.27	0.0000000127
1.28	0.0128	0.000128	1.28	0.0000000128
30.49	0.3049	0.003049	30.49	0.0000003049
99.99	99999.9999	999999999999.999999	99999999999999999.99	9999999999999999999999999999.9999999999

# Unannotated bytes keep their original contents alongside annotated bytes.
query T
SELECT DISTINCT hex(plain_bytes) FROM read_avro('test/decimal_bytes.avro');
----
0BE9
