recordArray	STRUCT(longRecordField BIGINT, stringRecordField VARCHAR, intRecordField INTEGER, floatRecordField FLOAT)[]
intOrStringArray	UNION(u1 INTEGER, u2 VARCHAR)[]
recordMap	MAP(VARCHAR, STRUCT(doubleRecordField DOUBLE, fixedRecordField BLOB))
intOrStringMap	MAP(VARCHAR, UNION(u1 INTEGER, u2 VARCHAR))
nullOrRecordUnion	STRUCT(stringArray VARCHAR[], enumRecordField ENUM('A', 'B', 'C', 'D'))

