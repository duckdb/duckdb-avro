statement ok
COPY (SELECT * FROM read_avro('test/corpus/gh_sksamuel__avro4s/eithers.avro')) TO '__TEST_DIR__/eithers.avro' (FORMAT avro)

# the written file reads back with other types (an Avro union is positional: a nullable
# UNION column comes back with its members named after their branch index), so the rows are
# compared as text
query II
